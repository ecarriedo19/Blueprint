# Environment Variables for Blueprint Application

# Supabase Configuration (for RAG/Vector Search)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Email Service Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Database Configuration
# SQLite databases are created automatically:
# - users.db (user data, projects, quotes)
# - sessions.db (user sessions)

# Application Configuration
NODE_ENV=development
PORT=4000
SESSION_SECRET=blueprint-session-secret-key-change-in-production

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5174
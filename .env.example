# Copy to .env and fill in values. Never commit .env.
# VITE_* variables are embedded in the browser bundle at build time - do not put server secrets in them.

# --- Frontend (Vite) ---
# Express API base URL
VITE_API_BASE_URL=http://localhost:4000

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Gemini API key (read by both the AI Copilot page and server.cjs)
VITE_GEMINI_API_KEY=

# --- Backend (server.cjs) ---
# Signs Express session cookies
SESSION_SECRET=
# Public URL of the frontend (Stripe redirects, invitation links)
FRONTEND_URL=http://localhost:5173
# Encrypts stored QuickBooks OAuth tokens
ENCRYPTION_KEY=

# Supabase (pgvector knowledge base for the RAG copilot)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (team invitation emails)
RESEND_API_KEY=

# QuickBooks Online OAuth (optional)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:4000/api/integrations/quickbooks/callback

# Optional: address allowed to receive repeated test invitations
INVITE_TEST_EMAIL=
